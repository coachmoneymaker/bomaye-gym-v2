{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/schedule",
      "destination": "/stundenplan",
      "permanent": true
    },
    {
      "source": "/coming-soon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alle-preise",
      "destination": "/preise",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "probetraining"
        }
      ],
      "destination": "/probetraining",
      "permanent": false
    },
    {
      "source": "/index",
      "has": [
        {
          "type": "query",
          "key": "probetraining"
        }
      ],
      "destination": "/probetraining",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/probetraining",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
